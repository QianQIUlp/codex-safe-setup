---
import Base from '../layouts/Base.astro';
import { en } from '../i18n/en';
import Hero from '../components/Hero.astro';
import Principle from '../components/Principle.astro';
import Limits from '../components/Limits.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Verification from '../components/Verification.astro';
import Install from '../components/Install.astro';
import NotProtected from '../components/NotProtected.astro';
import OpenSource from '../components/OpenSource.astro';
---

<Base content={en}>
  <Hero content={en} />
  <Principle content={en} />
  <Limits content={en} />
  <BeforeAfter content={en} />
  <Verification content={en} />
  <Install content={en} />
  <NotProtected content={en} />
