---
import type { UiContent } from '../i18n/types';

interface Props {
  content: UiContent;
}

const { content } = Astro.props;
const t = content;
const isEn = content.lang === 'en';
const menuLabel = isEn ? 'Menu' : '菜单';
---

<header class="site-header">
  <div class="container header-inner">
    <a class="wordmark" href={t.path === '/' ? '/' : '/zh-CN/'} aria-label="Codex Safe Setup — {t.meta.title}">
      <svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true">
        <rect x="1" y="1" width="30" height="30" rx="6" fill="#1c1f23"></rect>
        <rect x="7" y="7" width="18" height="18" rx="3" fill="#f6f6f4"></rect>
        <circle cx="16" cy="16" r="4" fill="#0b5bd3"></circle>
        <path d="M7 7 L2 2 M25 7 L30 2 M7 25 L2 30 M25 25 L30 30" stroke="#0b5bd3" stroke-width="2" stroke-linecap="round"></path>
      </svg>
      <span>Codex Safe Setup</span>
    </a>

    <nav class="main-nav" aria-label={isEn ? 'Main' : '主导航'}>
      <a href={t.nav.howItWorks.href}>{t.nav.howItWorks.label}</a>
      <a href={t.nav.install.href}>{t.nav.install.label}</a>
      <a href={t.nav.threatModel.href} target="_blank" rel="noopener noreferrer">
        {t.nav.threatModel.label}
      </a>
      <a href={t.nav.github.href} target="_blank" rel="noopener noreferrer">
        {t.nav.github.label}
      </a>
      <span class="lang-switch">
        <a href="/" lang="en" aria-current={content.lang === 'en' ? 'page' : undefined}>EN</a>
        <a href="/zh-CN/" lang="zh-CN" aria-current={content.lang === 'zh-CN' ? 'page' : undefined}>中文</a>
      </span>
    </nav>

    <details class="nav-menu">
      <summary class="nav-toggle">{menuLabel}</summary>
      <div class="nav-panel">
        <a href={t.nav.howItWorks.href}>{t.nav.howItWorks.label}</a>
        <a href={t.nav.install.href}>{t.nav.install.label}</a>
        <a href={t.nav.threatModel.href} target="_blank" rel="noopener noreferrer">
          {t.nav.threatModel.label}
        </a>
        <a href={t.nav.github.href} target="_blank" rel="noopener noreferrer">
          {t.nav.github.label}
        </a>
        <div class="lang-row">
          <a href="/" lang="en" aria-current={content.lang === 'en' ? 'page' : undefined}>EN</a>
          <a href="/zh-CN/" lang="zh-CN" aria-current={content.lang === 'zh-CN' ? 'page' : undefined}>中文</a>
        </div>
      </div>
    </details>
  </div>
</header>
