---
import type { UiContent } from '../i18n/types';

interface Props {
  content: UiContent;
}

const { content } = Astro.props;
const t = content;
const home = t.lang === 'en' ? '/' : '/zh-CN/';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="wordmark" href={home}>
          <svg width="24" height="24" viewBox="0 0 32 32" aria-hidden="true">
            <rect x="1" y="1" width="30" height="30" rx="6" fill="#1c1f23"></rect>
            <rect x="7" y="7" width="18" height="18" rx="3" fill="#f6f6f4"></rect>
            <circle cx="16" cy="16" r="4" fill="#0b5bd3"></circle>
            <path d="M7 7 L2 2 M25 7 L30 2 M7 25 L2 30 M25 25 L30 30" stroke="#0b5bd3" stroke-width="2" stroke-linecap="round"></path>
          </svg>
          <span>Codex Safe Setup</span>
        </a>
        <p class="footer-tagline">{t.footer.tagline}</p>
      </div>

      <nav class="footer-links" aria-label={t.lang === 'en' ? 'Project links' : '项目链接'}>
        {t.footer.links.map((link) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer">
            {link.label}
          </a>
        ))}
      </nav>

      <div class="footer-lang">
        <span>{t.footer.languageLabel}</span>
        <div class="lang-row">
          <a href="/" lang="en" aria-current={content.lang === 'en' ? 'page' : undefined}>English</a>
          <a href="/zh-CN/" lang="zh-CN" aria-current={content.lang === 'zh-CN' ? 'page' : undefined}>中文</a>
        </div>
      </div>
    </div>
    <p class="footer-bottom">{t.footer.disclaimer}</p>
  </div>
</footer>
